<Project Sdk="Microsoft.NET.Sdk">
  <!-- UNTESTED. Build on GitHub servers with public packages (no game files needed).
       The Unity version is a guess; if the build fails or the mod misbehaves in the game, match it
       to the game's real Unity version. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MiSideMinecraft</AssemblyName>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.16" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
